---
/** Small line icons for the Visit page's contact bar.
 *
 *  Deliberately narrow in scope: the site is otherwise icon-free, and these
 *  three earn their place because each labels a distinct outbound action
 *  (dial / compose / navigate) rather than decorating a heading.
 *
 *  Drawn on a 24-grid with a 1.75 stroke and `currentColor`, so they inherit
 *  the button's text colour through every state — including .btn.ghost:hover,
 *  which inverts to white. */
interface Props {
  name: "phone" | "mail" | "directions";
  size?: number;
  class?: string;
}
const { name, size = 16, class: className } = Astro.props;
---

<svg
  class:list={["icon", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === "phone" && (
      <path d="M6.5 3.5h3l1.5 4-2 1.4a12 12 0 0 0 6.1 6.1l1.4-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2Z" />
    )
  }
  {
    name === "mail" && (
      <>
        <rect x="2.75" y="5" width="18.5" height="14" rx="2.5" />
        <path d="m3.5 7 7.3 5.4a2 2 0 0 0 2.4 0L20.5 7" />
      </>
    )
  }
  {
    name === "directions" && (
      <>
        <path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z" />
        <circle cx="12" cy="10" r="2.5" />
      </>
    )
  }
</svg>

<style>
  .icon {
    flex: none;
    /* Nudges the optical centre onto the button's text baseline — the glyphs
       read slightly low against uppercase type without it. */
    margin-top: -1px;
  }
</style>
