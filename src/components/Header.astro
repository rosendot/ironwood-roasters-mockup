---
/** Sticky dark header. The active tab is driven by the current route so each
 *  page doesn't have to hand-mark its own nav link. */
const links = [
  { href: "/", label: "Home" },
  { href: "/coffee/", label: "Coffee" },
  { href: "/wholesale/", label: "Wholesale" },
  { href: "/our-craft/", label: "Our Craft" },
  { href: "/journal/", label: "Journal" },
  { href: "/visit/", label: "Visit" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="site-header" id="header">
  <div class="wrap">
    <a class="brand" href="/">
      <img class="mark" src="/emblem.png" alt="" width="40" height="40" aria-hidden="true" />
      <span class="name">Ironwood Roasters<small>Asheville · NC</small></span>
    </a>
    <nav class="nav" id="nav" aria-label="Primary">
      {
        links.map((l) => (
          <a class={isActive(l.href) ? "lnk active" : "lnk"} href={l.href}>
            {l.label}
          </a>
        ))
      }
      <a class="btn" href="/coffee/">Shop Coffee</a>
    </nav>
    <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav">
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
  </div>
</header>
